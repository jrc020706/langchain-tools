# Copy this file as `.env` and put your Google (Gemini) API key here.
# Get a free one at https://aistudio.google.com
# Without an API key the agent runs in simulated (demo) mode.
GOOGLE_API_KEY=your_google_api_key_here
MODEL_NAME=gemini-2.5-flash

# Listening host and port (optional).
# - Local: leave them untouched; defaults are 127.0.0.1 with port 7860 (app.py)
#   and 8000 (mcp_server.py).
# - Remote deployment (Render/Docker): use HOST=0.0.0.0; Render injects
#   PORT automatically, so there is no need to define it there.
#HOST=0.0.0.0
#PORT=7860
