# Copia este archivo como `.env` y pon tu API key de Google (Gemini).
# Consigue una gratis en https://aistudio.google.com
# Sin API key el agente funciona en modo simulado (demo).
GOOGLE_API_KEY=tu_api_key_de_google_aqui
MODEL_NAME=gemini-2.5-flash

# Host y puerto de escucha (opcionales).
# - Local: no los toques; por defecto 127.0.0.1 con puerto 7860 (app.py)
#   y 8000 (mcp_server.py).
# - Despliegue remoto (Render/Docker): usa HOST=0.0.0.0; Render inyecta
#   PORT automáticamente, así que no hace falta definirlo allí.
#HOST=0.0.0.0
#PORT=7860
